# EditorConfig untuk konsistensi format kode lintas editor dan OS.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = true

[{*.md, *.json, *.yaml, *.yml, *.css, *.html}]
indent_size = 2

[*.ts]
indent_size = 2

[*.tsx]
indent_size = 2

[*.{sql,md}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab