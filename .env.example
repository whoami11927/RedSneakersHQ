NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never add the NEXT_PUBLIC_ prefix to this key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Sandbox credentials. The server key must remain server-only.
MIDTRANS_SERVER_KEY=replace-with-midtrans-sandbox-server-key
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=replace-with-midtrans-sandbox-client-key
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# Local demo accounts created by `npm run seed:users`.
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace-with-a-local-password-12-chars
DEMO_CASHIER_EMAIL=cashier@example.test
DEMO_CASHIER_PASSWORD=replace-with-a-local-password-12-chars
DEMO_CUSTOMER_EMAIL=customer@example.test
DEMO_CUSTOMER_PASSWORD=replace-with-a-local-password-12-chars

# Optional: number of simultaneous checkout RPC requests (2-50, default 10).
CONCURRENCY_TEST_REQUESTS=10
